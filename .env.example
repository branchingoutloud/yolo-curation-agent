# Copy to .env (gitignored) and fill in. See langgraph.json ("env": ".env").

# Model providers - any init_chat_model-compatible string works
ANTHROPIC_API_KEY=
ORCHESTRATOR_MODEL=anthropic:claude-sonnet-5

# Roboflow MCP - sourcing-agent, annotation-agent
ROBOFLOW_API_KEY=
ROBOFLOW_MCP_URL=https://mcp.roboflow.com

# Kaggle MCP - sourcing-agent
KAGGLE_MCP_URL=

# Web search - sourcing-agent (optional; sourcing still works on Roboflow/Kaggle without it)
TAVILY_API_KEY=

# Modal sandbox - annotation-agent, training-agent, eval-agent
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional but recommended for tracing during demos
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=yolo-deep-agent

# Where the virtual filesystem's /workspace/ route persists to disk
RUN_ARTIFACTS_DIR=./run_artifacts
