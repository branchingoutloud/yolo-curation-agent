# Copy to .env (gitignored) and fill in. See langgraph.json ("env": ".env").

# Model providers - any init_chat_model-compatible string works
ANTHROPIC_API_KEY=

# Ollama Cloud (https://ollama.com) - hosted large open-weight models over
# the same Ollama HTTP API a local `ollama serve` exposes, auth'd via Bearer
# API key instead of running locally. See tools/model_builder.py for the
# base_url/header wiring. A FREE-TIER key only allows ONE cloud call in
# flight at a time - model_builder.py wraps every cloud model in a
# process-wide lock to serialize calls rather than letting subagents hit the
# API concurrently and error. Leave OLLAMA_API_KEY blank and set
# OLLAMA_BASE_URL to a local/office server (e.g. http://localhost:11434) to
# use local Ollama instead - no such concurrency limit applies there.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com

# Every *_AGENT_MODEL below is an OPTIONAL override - if unset, that
# subagent inherits ORCHESTRATOR_MODEL automatically (deepagents' own
# subagent-building loop does `spec.get("model", model)`). Set these to
# split load across model sizes (e.g. a smaller model for mechanical
# subagents, a bigger one for tool-call-heavy ones) rather than one huge
# model handling every step - see agent.py/subagents/*.py for which
# subagent's job is tool-call-heavy vs. mechanical. "provider:model" string,
# same convention as ORCHESTRATOR_MODEL (init_chat_model-compatible) - e.g.
# "ollama:gpt-oss:120b". Confirmed against a real Ollama Cloud key/account:
# no "-cloud" suffix needed - the cloud catalog lists tags bare (check
# `GET {OLLAMA_BASE_URL}/api/tags` with your own key for the current list).
ORCHESTRATOR_MODEL=anthropic:claude-sonnet-5
PLANNING_AGENT_MODEL=
SOURCING_AGENT_MODEL=
DATASET_AGENT_MODEL=
TRAINING_AGENT_MODEL=
EVAL_AGENT_MODEL=

# HuggingFace - optional alternative/fallback provider; point any one
# *_AGENT_MODEL override above at "huggingface:<repo_id>" once
# langchain-huggingface is added to pyproject.toml and a real token is set
# here. Not wired to any subagent by default.
HUGGINGFACEHUB_API_TOKEN=

# Roboflow MCP - sourcing-agent, dataset-agent
ROBOFLOW_API_KEY=
ROBOFLOW_MCP_URL=https://mcp.roboflow.com/mcp

# Kaggle MCP - sourcing-agent, dataset-agent. Real working endpoint (confirmed
# to return real tools, not a guess): https://www.kaggle.com/mcp
# KAGGLE_API_KEY is optional - only needed if tool calls (not just listing)
# require auth; format is a Kaggle API token (KGAT_...), sent as a Bearer
# header (see tools/mcp_clients.py) - unverified whether Kaggle's MCP server
# actually expects this scheme, adjust if calls come back 401/403.
KAGGLE_MCP_URL=https://www.kaggle.com/mcp
KAGGLE_API_KEY=

# Web search - sourcing-agent (optional; sourcing still works on Roboflow/Kaggle without it)
TAVILY_API_KEY=

# --- Local GPU training (training-agent / eval-agent) ---
# training-agent and eval-agent run REAL YOLO training/eval inside the official
# ultralytics Docker image, on the machine the agent runs on, using its GPU
# (tools/gpu_exec.py -> `docker run --gpus all ...`, driver scripts in
# tools/gpu_drivers/). Prerequisites on that machine:
#   - Docker + the NVIDIA Container Toolkit (so `--gpus` works)
#   - run `langgraph dev` ON the GPU server itself (not over SSH) - the dataset
#     under run_artifacts/ is bind-mounted straight into the container, so there
#     is no upload/download and no remote-filesystem gap
#   - pull the image once:  docker pull ultralytics/ultralytics:latest
# All values below are optional overrides; the defaults suit a single-GPU box.
YOLO_TRAIN_IMAGE=ultralytics/ultralytics:latest
YOLO_TRAIN_GPUS=all
YOLO_TRAIN_DEVICE=0
YOLO_TRAIN_SHM=8g
YOLO_TRAIN_TIMEOUT=10800
YOLO_EVAL_TIMEOUT=1800

# Modal sandbox - LEGACY / not used by the active training path. ModalSandbox
# (backends/sandboxes.py) is still in the tree as a GPU alternative to the local
# Docker runner above, but training-agent/eval-agent no longer use it. Fill
# these only if you wire the runner to Modal instead of local Docker.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional but recommended for tracing during demos
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=yolo-deep-agent

# Where the virtual filesystem's /workspace/ route persists to disk
RUN_ARTIFACTS_DIR=./run_artifacts
